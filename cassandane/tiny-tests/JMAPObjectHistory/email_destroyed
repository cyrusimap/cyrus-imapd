#!perl
use Cassandane::Tiny;

sub test_email_destroyed ($self)
{
    my $jmap = $self->{jmap};

    my $res = $jmap->CallMethods([
        ['Mailbox/set', { create => {
            a => { name => 'A' },
            b => { name => 'B' },
        } }, 'R1'],
    ]);
    my $mboxA = $res->[0][1]{created}{a}{id};
    my $mboxB = $res->[0][1]{created}{b}{id};
    $self->assert_not_null($mboxA);
    $self->assert_not_null($mboxB);

    $res = $jmap->CallMethods([
        ['Email/set', { create => { m1 => {
            mailboxIds => { $mboxA => JSON::true, $mboxB => JSON::true },
            keywords => { '$flagged' => JSON::true, 'foo' => JSON::true },
            from => [{ email => 'from@example.com' }],
            subject => 'destroy me',
            textBody => [{ partId => '1' }],
            bodyValues => { 1 => { value => 'body' } },
        } } }, 'R1'],
    ]);
    my $emailId = $res->[0][1]{created}{m1}{id};
    $self->assert_not_null($emailId);

    $res = $jmap->CallMethods([
        ['Email/set', { destroy => [$emailId] }, 'R1'],
    ]);
    $self->assert_cmp_deeply([$emailId], $res->[0][1]{destroyed});

    # Without includeDestroyed a destroyed email is not found
    $res = $jmap->CallMethods([
        ['Email/get', { ids => [$emailId], properties => ['subject'] }, 'R1'],
        ['Email/get', { ids => [$emailId], includeReplaced => JSON::true,
                        properties => ['subject'] }, 'R2'],
    ]);
    $self->assert_cmp_deeply([], $res->[0][1]{list});
    $self->assert_cmp_deeply([$emailId], $res->[0][1]{notFound});
    $self->assert_cmp_deeply([], $res->[1][1]{list});
    $self->assert_cmp_deeply([$emailId], $res->[1][1]{notFound});

    # The final version has the mailboxes and keywords it was destroyed with
    $res = $jmap->CallMethods([
        ['Email/get', {
            ids => [$emailId],
            includeDestroyed => JSON::true,
            properties => ['subject', 'mailboxIds', 'keywords'],
        }, 'R1'],
    ]);
    $self->assert_cmp_deeply({
        accountId => 'cassandane',
        state => ignore(),
        list => [{
            id => $emailId,
            subject => 'destroy me',
            mailboxIds => { $mboxA => JSON::true, $mboxB => JSON::true },
            keywords => {
                '$flagged' => JSON::true,
                
                'foo' => JSON::true,
            },
            objectHistory => {
                version => code(sub { $_[0] > 0 }),
                replaced => re(qr/^\d{4}-\d\d-\d\dT/),
            },
        }],
        notFound => [],
        hasMoreHistory => jfalse,
    }, $res->[0][1]);

    # Same with includeReplaced, and with only the threadId property
    $res = $jmap->CallMethods([
        ['Email/get', {
            ids => [$emailId],
            includeDestroyed => JSON::true,
            includeReplaced => JSON::true,
            properties => ['threadId'],
        }, 'R1'],
    ]);
    $self->assert_cmp_deeply([{
        id => $emailId,
        threadId => re(qr/^.+$/),
        objectHistory => {
            version => code(sub { $_[0] > 0 }),
            replaced => re(qr/^\d{4}-\d\d-\d\dT/),
        },
    }], $res->[0][1]{list});
    $self->assert_cmp_deeply([], $res->[0][1]{notFound});

    # historyAfter filters out the destroyed version
    $res = $jmap->CallMethods([
        ['Email/get', {
            ids => [$emailId],
            includeDestroyed => JSON::true,
            historyAfter => '2000-01-01T00:00:00Z',
            properties => ['subject'],
        }, 'R1'],
        ['Email/get', {
            ids => [$emailId],
            includeDestroyed => JSON::true,
            historyAfter => '2100-01-01T00:00:00Z',
            properties => ['subject'],
        }, 'R2'],
    ]);
    $self->assert_num_equals(1, scalar $res->[0][1]{list}->@*);
    $self->assert_cmp_deeply([], $res->[1][1]{list});

    # Once the expunged copies are cleaned up the history is gone
    $self->{instance}->run_command({ cyrus => 1 }, 'cyr_expire', '-X' => '0');
    $res = $jmap->CallMethods([
        ['Email/get', { ids => [$emailId], includeDestroyed => JSON::true,
                        properties => ['subject'] }, 'R1'],
    ]);
    $self->assert_cmp_deeply([], $res->[0][1]{list});
    $self->assert_cmp_deeply([$emailId], $res->[0][1]{notFound});
}
