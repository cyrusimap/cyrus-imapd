#!perl
use Cassandane::Tiny;

sub test_require_conversations
    :min_version_3_1 :NoConversations
    ($self)
{
    my $jmap = $self->{jmap};
    my $JMAPRequest = {
        using => ['urn:ietf:params:jmap:core'],
        methodCalls => [['Core/echo', { }, 'R1']],
    };

    # request should fail
    my ($response, undef) = $jmap->request($JMAPRequest);
    $self->assert(not $response->is_success);

    # httpd should syslog an error
    $self->assert_syslog_matches(
        $self->{instance},
        qr/event=jmap\.module\.disabled/,
    );
}
