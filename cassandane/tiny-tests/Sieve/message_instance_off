#!perl
use Cassandane::Tiny;

# dkim2_message_instance defaults to off, and off does no DKIM2 work at all

sub test_message_instance_off
    :want_smtpdaemon
    ($self)
{
    my $msg = $self->{gen}->generate(subject => "Message 1");
    my ($hdrs, $body) = dkim2_split($msg->as_string());
    my $mi = dkim2_mi_header($hdrs, $body);
    $msg->add_header('Message-Instance', $mi);

    my $out = $self->sieve_redirect_message(<<'EOF', $msg);
require ["editheader"];
addheader "List-Id" "<l.example.com>";
deleteheader "Subject";
redirect "redirect@example.com";
EOF

    my @mis = dkim2_mi_values($out);
    $self->assert_num_equals(1, scalar @mis);
    $self->assert_str_equals($mi, $mis[0]);
}
