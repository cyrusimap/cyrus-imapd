#!perl
use Cassandane::Tiny;

# A jmapquery header condition matches an RFC 2047 encoded header at
# delivery, as it does once the message is stored.
sub test_jmapquery_header_encoded_word
    :needs_component_jmap
    ($self)
{
    my $imap = $self->{store}->get_client();
    $imap->create("INBOX.matches") or die;

    $self->{instance}->install_sieve_script(<<'EOF');
require ["x-cyrus-jmapquery", "fileinto"];
if jmapquery text:
  {
    "header" : [ "Subject", "[Wordfence Alert]", "startsWith" ]
  }
.
{
  fileinto "INBOX.matches";
}
EOF

    xlog $self, "Deliver a message whose Subject is a folded Q encoded-word";
    $self->{instance}->deliver($self->{gen}->generate(
        subject => "=?us-ascii?Q?[Wordfence_Alert]_Problems_found_on_digitalsign?=\r\n"
                 . " =?us-ascii?Q?agepulse.com?=",
    ));

    xlog $self, "and one whose Subject doesn't match";
    $self->{instance}->deliver($self->{gen}->generate(
        subject => "=?us-ascii?Q?[Something_Else]?=",
    ));

    $imap->select('INBOX.matches');
    $self->assert_num_equals(1, $imap->get_response_code('exists'));
    $imap->select('INBOX');
    $self->assert_num_equals(1, $imap->get_response_code('exists'));
}
