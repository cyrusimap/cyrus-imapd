#!perl
use Cassandane::Tiny;

sub test_mailboxidexists_acl_bypass
    :min_version_3_0 :NoAltNameSpace
    ($self)
{
    my $talk = $self->{store}->get_client();

    my $hitfolder = 'INBOX.oracle-hit';
    my $missfolder = 'INBOX.oracle-miss';
    $talk->create($hitfolder);
    $talk->create($missfolder);

    # Create a victim user with a private folder not shared with the attacker
    $self->{instance}->create_user('victim');
    my $victimstore = $self->{instance}->get_service('imap')->create_store(
        username => 'victim');
    my $victimtalk = $victimstore->get_client();

    # We need extra folders in the victim account so their compact-id doesn't
    # match one of ours or our test will find the wrong folder
    $victimtalk->create('INBOX.first');
    $victimtalk->create('INBOX.second');
    $victimtalk->create('INBOX.third');

    # Here's the real target
    $victimtalk->create('INBOX.secret-project');
    $self->assert_str_equals('ok', $victimtalk->get_last_completion_response());

    my $compactid =  $victimtalk->status('INBOX.secret-project', "(mailboxid)")->{mailboxid}[0];
    my $uniqueid =  $victimtalk->status('INBOX.secret-project', "(uniqueid)")->{uniqueid}[0];

    $self->assert_not_null($compactid);
    $self->assert_not_null($uniqueid);

    # Ensure that compactid doesn't exist in our account
    xlog "Ensure we don't have a compact id that our victim has";

    $talk->list("", "*", "return", ["status", ["mailboxid"]]);
    my %ids = map { $_->{mailboxid}[0] => 1 } values $talk->get_response_code('status')->%*;
    $self->assert_null($ids{$compactid});

    # Install a Sieve script that uses mailboxidexists against another user's mailbox.
    $self->{instance}->install_sieve_script(<<~"EOF", username => 'cassandane');
        require ["fileinto", "mailboxid"];
        if mailboxidexists "$compactid" {
            fileinto "$hitfolder";
        } elsif mailboxidexists "$uniqueid" {
            fileinto "$hitfolder";
        } else {
            fileinto "$missfolder";
        }
        EOF

    # Deliver a message -- mailboxidexists must not reveal the victim's folder
    my $msg = $self->{gen}->generate(subject => "Probe");
    $self->{instance}->deliver($msg, users => ['cassandane']);

    # Without the fix the message lands in oracle-hit (the bug leaks existence).
    # With the fix the message must land in oracle-miss.
    $self->{store}->set_folder($missfolder);
    $self->check_messages({ 1 => $msg }, check_guid => 0);
}
