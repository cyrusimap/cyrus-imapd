#!perl
use Cassandane::Tiny;

sub test_addressbook_set_update_readonly
    ($self)
{
    my $jmap = $self->default_user->jmap;

    my $id = $jmap->request([[ 'AddressBook/set', {
        create => { 1 => { name => 'foo' } },
    } ]])->single_sentence('AddressBook/set')->arguments->{created}{1}{id};
    $self->assert_not_null($id);

    my @props = qw( name isDefault myRights mailboxUniqueId
                    cyrusimap.org:href );
    my $get = sub (@props) {
        $jmap->request([[ 'AddressBook/get', {
            ids => [ $id ],
            (@props ? (properties => \@props) : ()),
        } ]])->single_sentence('AddressBook/get')->arguments->{list}[0];
    };
    my $orig = $get->(@props);
    $self->assert_equals(JSON::false, $orig->{isDefault});

    # RFC 8620 5.3: a server-set value MUST NOT change
    for my $patch (
        { isDefault            => JSON::true },
        { myRights             => { %{ $orig->{myRights} },
                                    mayDelete => JSON::false } },
        { 'myRights/mayDelete' => JSON::false },
        { mailboxUniqueId      => 'notauniqueid' },
        { 'cyrusimap.org:href' => '/dav/notanaddressbook/' },
    ) {
        my ($prop) = map { s{/.*}{}r } keys %$patch;
        my $res = $jmap->request([[ 'AddressBook/set', {
            update => { $id => $patch },
        } ]]);
        $self->assert_cmp_deeply(
            { $id => { type => 'invalidProperties', properties => [ $prop ] } },
            $res->single_sentence('AddressBook/set')->arguments->{notUpdated},
            "patch $prop",
        );
        $self->assert_cmp_deeply($orig, $get->(@props), "unchanged after $prop");
    }

    # ... but may be sent unchanged
    my %same = map { $_ => $orig->{$_} } @props;
    my $res = $jmap->request([[ 'AddressBook/set', {
        update => { $id => { %same, name => 'bar' } },
    } ]]);
    $self->assert_cmp_deeply(
        { $id => undef },
        $res->single_sentence('AddressBook/set')->arguments->{updated},
    );
    $self->assert_str_equals('bar', $get->('name')->{name});

    # ... including the whole object as AddressBook/get returns it
    $res = $jmap->request([[ 'AddressBook/set', {
        update => { $id => $get->() },
    } ]]);
    $self->assert_cmp_deeply(
        { $id => undef },
        $res->single_sentence('AddressBook/set')->arguments->{updated},
    );
}
