#!perl
use Cassandane::Tiny;

sub test_addressbook_set_sortorder
    ($self)
{
    my $jmap = $self->{jmap};

    # Create addressbook
    my $res = $jmap->CallMethods([
        ['AddressBook/set', {
            create => {
                '1' => {
                    name => 'A',
                    sortOrder => 5
                }
            },
        }, 'R1'],
        ['AddressBook/get', {
            ids => ['#1'],
            properties => ['sortOrder']
        }, 'R2'],
    ]);
    $self->assert(exists $res->[0][1]{created}{1});
    $self->assert_num_equals(5, $res->[1][1]{list}[0]{sortOrder});
    my $id = $res->[0][1]{created}{"1"}{id};

    # RFC 9610 S2: 0 <= sortOrder < 2^31
    $res = $jmap->CallMethods([
        ['AddressBook/set',
            { update => {
                $id => {
                    sortOrder => -1
                }
            }
        }, "R1"],
        ['AddressBook/set',
            { update => {
                $id => {
                    sortOrder => 2147483648
                }
            }
        }, "R2"],
    ]);
    $self->assert_cmp_deeply({
        $id => superhashof({
            type => 'invalidProperties',
            properties => ['sortOrder'],
        }),
    }, $res->[0][1]{notUpdated});
    $self->assert_cmp_deeply({
        $id => superhashof({
            type => 'invalidProperties',
            properties => ['sortOrder'],
        }),
    }, $res->[1][1]{notUpdated});

    $res = $jmap->CallMethods([
        ['AddressBook/set',
            { update => {
                $id => {
                    sortOrder => 2147483647
                }
            }
        }, "R1"],
        ['AddressBook/get', {
            ids => [$id],
            properties => ['sortOrder']
        }, 'R2'],
    ]);
    $self->assert(exists $res->[0][1]{updated}{$id});
    $self->assert_num_equals(2147483647, $res->[1][1]{list}[0]{sortOrder});

    # Update sortOrder
    $res = $jmap->CallMethods([
        ['AddressBook/set',
            { update => {
                $id => {
                    sortOrder => 10
                }
            }
        }, "R1"],
        ['AddressBook/get', {
            ids => [$id],
            properties => ['sortOrder']
        }, 'R2'],
    ]);
    $self->assert(exists $res->[0][1]{updated}{$id});
    $self->assert_num_equals(10, $res->[1][1]{list}[0]{sortOrder});
}
