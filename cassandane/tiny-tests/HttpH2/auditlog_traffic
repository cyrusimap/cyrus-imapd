#!perl
use Cassandane::Tiny;
use Time::HiRes qw(sleep);

# An HTTP/2 connection's audit-logged traffic counts what went over the
# socket, not whatever a build with HTTP/3 support reads from the session
# context, which for HTTP/2 isn't an HTTP/3 one.
sub test_auditlog_traffic
    :needs_dependency_nghttp2
    ($self)
{
    $self->{caldav}->GetCalendars();

    my $rpath = '/dav/calendars/user/cassandane/Default/traffic.ics';
    my $ical = join "\r\n",
        'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Cassandane//HttpH2//EN',
        'BEGIN:VEVENT', 'UID:auditlog-traffic@example.com',
        'DTSTAMP:20260101T000000Z', 'DTSTART:20260101T100000Z',
        'DURATION:PT1H', 'DESCRIPTION:' . ('x' x 20000),
        'END:VEVENT', 'END:VCALENDAR', '';

    my $put = $self->http2_request(
        method  => 'PUT',
        path    => $rpath,
        headers => [ 'content-type' => 'text/calendar; charset=utf-8' ],
        body    => $ical,
    );
    $self->assert_num_equals(201, $put->{status});

    # discard syslogs from setup and the PUT
    sleep 0.5;
    $self->{instance}->getsyslog();

    xlog $self, "GET the event over HTTP/2";
    my $get = $self->http2_request(method => 'GET', path => $rpath);
    $self->assert_num_equals(200, $get->{status});
    my $len = length $get->{body};

    return if !$self->{instance}->{have_syslog_replacement};

    my @traffic;
    for (1 .. 50) {
        @traffic = $self->{instance}->getsyslog(
            qr/\bevent=auditlog\.traffic\b/);
        last if @traffic;
        sleep 0.1;
    }
    $self->assert_num_equals(1, scalar @traffic);

    for my $line (@traffic) {
        my ($in)  = $line =~ m/\bused\.bytes\.in=(\d+)/;
        my ($out) = $line =~ m/\bused\.bytes\.out=(\d+)/;
        $self->assert_num_lt(2 * $len, $in);
        $self->assert_num_lt(2 * $len, $out);
        $self->assert($in > 0 && $out > 0, "no traffic counted: $line");
    }
}
