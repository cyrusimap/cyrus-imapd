#!perl
use Cassandane::Tiny;

# A request refused when its headers arrive is answered before its body
# has all been sent.  The server stops reading the stream, so a client
# that then gives up short of its Content-Length ends only that request,
# not the whole connection.
sub test_early_response
    :SetMaxMessageSize(8k)
    ($self)
{
    $self->{caldav}->GetCalendars();
    $self->{instance}->getsyslog();

    my $res = $self->http3_request(
        method => 'PUT',
        path => '/dav/calendars/user/cassandane/Default/big.ics',
        headers => [ 'Content-Type' => 'text/calendar' ],
        body => 'x' x (4 * 1024 * 1024),
    );
    $self->assert_num_equals(413, $res->{status});

    my @failed = $self->{instance}->getsyslog(
        qr/http3\.stream\.read_failed|quic\.conn\.read_failed/);
    $self->assert_cmp_deeply([], \@failed);
}
