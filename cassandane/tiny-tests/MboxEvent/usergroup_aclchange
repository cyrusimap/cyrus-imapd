#!perl
use Cassandane::Tiny;

# Joining or leaving a group changes what the member can see without changing
# any mailbox ACL, so SETUSERGROUP and UNSETUSERGROUP emit the AclChange
# events themselves: one per owner whose mailboxes the group can read.

sub _usergroup_aclchange_events ($self) {
    return [
        grep { $_->{event} eq q{AclChange} }
        map  { decode_json($_->{MESSAGE}) }
        $self->{instance}->getnotify->@*
    ];
}

sub test_usergroup_aclchange
    :Mboxgroups :ReverseACLs
    ($self)
{
    my $admintalk = $self->{adminstore}->get_client();

    $self->{instance}->create_user('other');
    $admintalk->create('user.other.Shared') or die;
    $admintalk->setacl('user.other', 'group:team', 'lr') or die;
    $admintalk->setacl('user.other.Shared', 'group:team', 'lrs') or die;

    $self->{instance}->getnotify();

    $admintalk->_imap_cmd('SETUSERGROUP', 0, '', 'cassandane', 'group:team');
    $self->assert_str_equals('ok', $admintalk->get_last_completion_response());

    my $events = $self->_usergroup_aclchange_events();
    $self->assert_cmp_deeply(
        [ superhashof({
            aclSubject => 'cassandane',
            aclRights  => re(qr/r/),
        }) ],
        $events,
        'join: one event for the owner',
    );

    $admintalk->_imap_cmd('UNSETUSERGROUP', 0, '', 'cassandane', 'group:team');
    $self->assert_str_equals('ok', $admintalk->get_last_completion_response());

    $events = $self->_usergroup_aclchange_events();
    $self->assert_cmp_deeply(
        [ superhashof({ aclSubject => 'cassandane' }) ],
        $events,
        'leave: one event for the owner',
    );
    $self->assert(! exists $events->[0]{aclRights}, 'leave: no aclRights');

    # A group that can't read anything emits nothing
    $admintalk->_imap_cmd('SETUSERGROUP', 0, '', 'cassandane', 'group:none');
    $self->assert_str_equals('ok', $admintalk->get_last_completion_response());
    $self->assert_cmp_deeply([], $self->_usergroup_aclchange_events());
}

sub assert_usergroup_aclchange ($self, $desc, $arg)
{
    my $admintalk = $self->{adminstore}->get_client();
    $admintalk->_imap_cmd($arg->{command}, 0, '', 'cassandane', $arg->{group});
    $self->assert_str_equals('ok', $admintalk->get_last_completion_response());

    $self->assert_cmp_deeply(
        $arg->{events},
        $self->_usergroup_aclchange_events(),
        $desc,
    );
}

# The owner's event must not depend on which of the group's mailboxes comes
# first: notification is off for \Junk by default, and Junk sorts before Work.
sub test_usergroup_aclchange_excluded_first
    :Mboxgroups :ReverseACLs
    ($self)
{
    my $admintalk = $self->{adminstore}->get_client();

    $self->{instance}->create_user('other');
    my $othertalk = $self->{instance}->get_service('imap')
                         ->create_store(username => 'other')->get_client();
    $othertalk->create('Junk') or die;
    $othertalk->setmetadata('Junk', '/private/specialuse', '\\Junk')
        or die;
    $othertalk->create('Work') or die;
    $admintalk->setacl('user.other.Junk', 'group:team', 'lr') or die;
    $admintalk->setacl('user.other.Work', 'group:team', 'lr') or die;

    $self->{instance}->getnotify();

    $self->assert_usergroup_aclchange('join', {
        command => 'SETUSERGROUP',
        group   => 'group:team',
        events  => [ superhashof({ aclSubject => 'cassandane' }) ],
    });
}

# Setting a membership that is already in place, or removing one that
# isn't, changes nobody's access, so it emits nothing.
sub test_usergroup_aclchange_noop
    :Mboxgroups :ReverseACLs
    ($self)
{
    my $admintalk = $self->{adminstore}->get_client();

    $self->{instance}->create_user('other');
    $admintalk->setacl('user.other', 'group:team', 'lr') or die;

    $self->{instance}->getnotify();

    my $event = superhashof({ aclSubject => 'cassandane' });

    $self->assert_usergroup_aclchange('join', {
        command => 'SETUSERGROUP',
        group   => 'group:team',
        events  => [ $event ],
    });

    $self->assert_usergroup_aclchange('join again', {
        command => 'SETUSERGROUP',
        group   => 'group:team',
        events  => [],
    });

    $self->assert_usergroup_aclchange('leave', {
        command => 'UNSETUSERGROUP',
        group   => 'group:team',
        events  => [ $event ],
    });

    $self->assert_usergroup_aclchange('leave again', {
        command => 'UNSETUSERGROUP',
        group   => 'group:team',
        events  => [],
    });
}
