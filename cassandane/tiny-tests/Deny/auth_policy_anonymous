#!perl
use Cassandane::Tiny;
use MIME::Base64 qw(encode_base64);

sub test_auth_policy_anonymous
    :NoStartInstances
    ($self)
{
    $self->{instance}->{config}->set(
        allowanonymouslogin => 'yes',
        sasl_mech_list => 'PLAIN LOGIN ANONYMOUS',
        auth_userexists => 'yes',
        auth_notreplicaonly => 'yes',
    );
    $self->_start_instances();

    # SASL ANONYMOUS passes the login policy
    my $talk = $self->{instance}->get_service('imap')
        ->create_store()->get_client(NoLogin => 1);
    $talk->_imap_cmd('AUTHENTICATE', 0, '', 'ANONYMOUS',
                     encode_base64('trace', ''));
    $self->assert_str_equals('ok', $talk->get_last_completion_response());
}
