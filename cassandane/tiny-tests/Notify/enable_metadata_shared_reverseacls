#!perl
use Cassandane::Tiny;

sub test_enable_metadata_shared_reverseacls
    :needs_component_idled :ReverseACLs :NoAltNamespace
    ($self)
{
    $self->{instance}->add_start(name => 'idled', argv => [ 'idled' ]);
    $self->{instance}->start();

    my $svc = $self->{instance}->get_service('imap');
    my $admintalk = $svc->create_store(username => 'admin')->get_client();
    $admintalk->create("user.otheruser") or die "create: $@";
    $admintalk->create("user.otheruser.shared") or die "create: $@";
    $admintalk->setacl("user.otheruser.shared", "cassandane", "lr")
        or die "setacl: $@";

    my $store = $svc->create_store();
    my $talk = $store->get_client();
    my $res = $talk->_imap_cmd('ENABLE', 0, 'enabled', 'METADATA');
    $self->assert_num_equals(1, $res->{metadata});

    my @got;
    my %handlers = (metadata => sub { push @got, $_[1] });

    # with reverse ACLs, every mailbox the user can see counts
    $admintalk->setmetadata('user.otheruser.shared', '/shared/comment', 'x');
    $self->assert_str_equals('ok', $admintalk->get_last_completion_response());
    $admintalk->setmetadata('user.cassandane', '/shared/comment', 'y');
    $self->assert_str_equals('ok', $admintalk->get_last_completion_response());

    $self->assert($store->idle_response(\%handlers, 10), "got METADATA");
    $self->assert($store->idle_response(\%handlers, 10), "got METADATA");
    $self->assert_cmp_deeply([[ 'user.otheruser.shared', '/shared/comment' ], [ 'INBOX', '/shared/comment' ]], \@got);
}
