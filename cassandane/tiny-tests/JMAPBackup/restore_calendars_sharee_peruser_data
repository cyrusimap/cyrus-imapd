#!perl
use Cassandane::Tiny;

# A sharee's per-user edits to a shared event are stored as that sharee's
# private annotation on the resource, and the owner must never see them.
# That has to stay true when the owner destroys the event and recovers it
# with Backup/restoreCalendars.

sub test_restore_calendars_sharee_peruser_data
    ($self)
{
    my $owner_jmap = $self->{jmap};
    my $cal = $self->default_user->calendars->default;

    xlog $self, "create sharee and share the default calendar";
    my $sharee_user = $self->{instance}->create_user('sharee');
    my $sharee_jmap = $sharee_user->jmap;
    $cal->share_with($sharee_user => [qw(mayReadItems mayWriteAll)]);

    my $event = $cal->create_event({ title => 'shared event' });
    my $event_id = $event->id;

    xlog $self, "sharee sets a private per-user keyword on the event";
    my $res = $sharee_jmap->request([
        ['CalendarEvent/set', {
            accountId => 'cassandane',
            update => {
                $event_id => { keywords => { 'sharee-keyword' => JSON::true } },
            },
        }],
    ]);
    $self->assert(exists $res->single_sentence('CalendarEvent/set')
                          ->arguments->{updated}{$event_id});

    $self->assert_keywords_seen($sharee_jmap, { 'sharee-keyword' => JSON::true });
    $self->assert_keywords_seen($owner_jmap, {});

    sleep 2;
    my $mark = time();
    sleep 2;

    xlog $self, "owner destroys the event";
    $event->destroy;

    my $period = "PT" . (time() - $mark) . "S";

    xlog $self, "owner restores calendars to before the destroy";
    $res = $owner_jmap->request([
        ['Backup/restoreCalendars', {
            undoPeriod     => $period,
            verboseLogging => JSON::true,
        }],
    ]);
    $self->assert_num_equals(1,
        $res->single_sentence('Backup/restoreCalendars')
            ->arguments->{numDestroysUndone});

    xlog $self, "owner still does not see the sharee's keyword";
    $self->assert_keywords_seen($owner_jmap, {});

    xlog $self, "sharee still sees their own keyword";
    $self->assert_keywords_seen($sharee_jmap, { 'sharee-keyword' => JSON::true });
}

sub assert_keywords_seen ($self, $jmap, $expect)
{
    my $res = $jmap->request([
        ['CalendarEvent/get', {
            accountId  => 'cassandane',
            properties => ['keywords'],
        }],
    ]);

    my $list = $res->single_sentence('CalendarEvent/get')->arguments->{list};
    $self->assert_num_equals(1, scalar @$list);
    $self->assert_deep_equals($expect, $list->[0]{keywords} // {});
}
