#!perl
use Cassandane::Tiny;

sub test_email_set_atomic_quota_crossroot
    :NoAltNameSpace
    ($self)
{
    my $user = $self->default_user;
    my $jmap = $user->jmap;
    $jmap->AddUsing('urn:ietf:params:jmap:conditional');

    my $inbox = $user->mailboxes->inbox;
    my $b     = $user->mailboxes->create({ name => 'B' });
    my sub email ($mailbox, $subject, $size) {
        return $user->emails->create({
            mailboxIds    => { $mailbox->id => JSON::true },
            subject       => $subject,
            bodyStructure => { type => 'text/plain', partId => 'p' },
            bodyValues    => { p => { value => 'x' x $size } },
        })->id;
    }
    my $big    = email($inbox, 'big', 4096);
    my $filler = email($b, 'filler', 5120);

    # B is its own quota root, with room for one of the two emails only
    my $admin = $self->{adminstore}->get_client();
    $admin->setquota('user.cassandane.B', '(STORAGE 7)');
    $self->assert_str_equals('ok', $admin->get_last_completion_response());

    my sub mailboxes {
        my $res = $jmap->request([
            [ 'Email/get', {
                ids        => [ $big, $filler ],
                properties => [ 'mailboxIds' ],
            } ],
        ]);
        return $res->single_sentence('Email/get')->arguments->{list};
    }

    xlog $self, "a move into another quota root is charged its size";
    my $res = $jmap->request([
        [ 'Email/set', {
            atomic => JSON::true,
            update => { $big => { mailboxIds => { $b->id => JSON::true } } },
        } ],
    ]);
    $self->assert_cmp_deeply(
        {
            type       => 'atomicFailure',
            notUpdated => { $big => { type => 'overQuota' } },
        },
        $res->single_sentence('error')->arguments,
    );
    $self->assert_cmp_deeply(
        bag(
            { id => $big,    mailboxIds => { $inbox->id => JSON::true } },
            { id => $filler, mailboxIds => { $b->id => JSON::true } },
        ),
        mailboxes(),
    );

    xlog $self, "moving the other email out in the same method makes room";
    $res = $jmap->request([
        [ 'Email/set', {
            atomic => JSON::true,
            update => {
                $big    => { mailboxIds => { $b->id => JSON::true } },
                $filler => { mailboxIds => { $inbox->id => JSON::true } },
            },
        } ],
    ]);
    $self->assert_cmp_deeply(
        { $big => undef, $filler => undef },
        $res->single_sentence('Email/set')->arguments->{updated},
    );
    $self->assert_cmp_deeply(
        bag(
            { id => $big,    mailboxIds => { $b->id => JSON::true } },
            { id => $filler, mailboxIds => { $inbox->id => JSON::true } },
        ),
        mailboxes(),
    );
}
