#!perl
use Cassandane::Tiny;

sub test_email_set_atomic_quota
    :NoAltNameSpace
    ($self)
{
    my $user = $self->default_user;
    my $jmap = $user->jmap;
    $jmap->AddUsing('urn:ietf:params:jmap:conditional');

    my $inbox = $user->mailboxes->inbox;
    my %body = (
        mailboxIds    => { $inbox->id => JSON::true },
        bodyStructure => { type => 'text/plain', partId => 'p' },
    );
    my $old = $user->emails->create({
        %body,
        subject    => 'old',
        bodyValues => { p => { value => 'old' } },
    })->id;

    my $admin = $self->{adminstore}->get_client();
    $admin->setquota('user.cassandane', '(MESSAGE 2)');
    $self->assert_str_equals('ok', $admin->get_last_completion_response());

    my %create = map {;
        $_ => { %body, subject => $_, bodyValues => { p => { value => $_ } } }
    } qw(a b);

    xlog $self, "two creates over the message quota fail together";
    my $res = $jmap->request([
        [ 'Email/set', { atomic => JSON::true, create => \%create } ],
    ]);
    $self->assert_cmp_deeply(
        {
            type       => 'atomicFailure',
            notCreated => {
                a => { type => 'overQuota' },
                b => { type => 'overQuota' },
            },
        },
        $res->single_sentence('error')->arguments,
    );

    xlog $self, "a destroy in the same method makes room for them";
    $res = $jmap->request([
        [ 'Email/set', {
            atomic  => JSON::true,
            create  => \%create,
            destroy => [ $old ],
        } ],
    ]);
    $self->assert_cmp_deeply(
        superhashof({
            created   => { a => ignore(), b => ignore() },
            destroyed => [ $old ],
        }),
        $res->single_sentence('Email/set')->arguments,
    );
}
