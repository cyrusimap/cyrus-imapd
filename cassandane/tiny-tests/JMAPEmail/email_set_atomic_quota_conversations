#!perl
use Cassandane::Tiny;

sub test_email_set_atomic_quota_conversations
    :NoAltNameSpace :QuotaUseConversations
    ($self)
{
    my $user = $self->default_user;
    my $jmap = $user->jmap;
    $jmap->AddUsing('urn:ietf:params:jmap:conditional');

    my $inbox = $user->mailboxes->inbox;
    my %body = (
        mailboxIds    => { $inbox->id => JSON::true },
        bodyStructure => { type => 'text/plain', partId => 'p' },
    );
    my $old = $user->emails->create({
        %body,
        subject    => 'old draft',
        bodyValues => { p => { value => 'old' } },
    })->id;

    my $admin = $self->{adminstore}->get_client();
    $admin->setquota('user.cassandane', '(MESSAGE 1)');
    $self->assert_str_equals('ok', $admin->get_last_completion_response());

    my %create = (
        new => { %body, subject => 'new draft', bodyValues => { p => { value => 'new' } } },
    );

    xlog $self, "a create over the conversations quota fails";
    my $res = $jmap->request([
        [ 'Email/set', { atomic => JSON::true, create => \%create } ],
    ]);
    $self->assert_cmp_deeply(
        { type => 'atomicFailure', notCreated => { new => { type => 'overQuota' } } },
        $res->single_sentence('error')->arguments,
    );

    xlog $self, "destroying the old email in the same method makes room";
    $res = $jmap->request([
        [ 'Email/set', {
            atomic  => JSON::true,
            create  => \%create,
            destroy => [ $old ],
        } ],
    ]);
    $self->assert_cmp_deeply(
        superhashof({
            created   => { new => ignore() },
            destroyed => [ $old ],
        }),
        $res->single_sentence('Email/set')->arguments,
    );
}
