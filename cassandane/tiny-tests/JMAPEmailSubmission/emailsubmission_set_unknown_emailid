#!perl
use Cassandane::Tiny;

# Invariant: a submission of an Email that can't be found is rejected with
# invalidProperties naming emailId (RFC 8621 S7.5).
sub test_emailsubmission_set_unknown_emailid
    ($self)
{
    my $jmap = $self->default_user->jmap;

    my $identityid = $jmap->request([
        [ 'Identity/get' => {} ],
    ])->single_sentence('Identity/get')->arguments->{list}[0]{id};
    $self->assert_not_null($identityid);

    my $set = $jmap->request([
        [ 'EmailSubmission/set' => {
            create => {
                s1 => {
                    identityId => $identityid,
                    emailId => 'Mnosuchemail',
                    envelope => {
                        mailFrom => { email => 'from@localhost' },
                        rcptTo => [{ email => 'rcpt@localhost' }],
                    },
                },
            },
        } ],
    ])->single_sentence('EmailSubmission/set')->as_set;
    $self->assert_cmp_deeply({
        s1 => {
            type => 'invalidProperties',
            properties => ['emailId'],
        },
    }, $set->create_errors);
    $self->assert_null($set->arguments->{created});
}
