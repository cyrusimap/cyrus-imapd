#!perl
use Cassandane::Tiny;
use DateTime;

sub test_emailsubmission_set_max_delayed_send_zero
    :needs_component_calalarmd :NoStartInstances
    ($self)
{
    $self->config_set(jmap_max_delayed_send => '0');
    $self->_start_instances();
    $self->_setup_http_service_objects();

    my $jmap = $self->default_user->jmap;

    my $res = $jmap->request([[ 'Identity/get', {} ]]);
    my $identityid
        = $res->single_sentence('Identity/get')->arguments->{list}[0]{id};
    my $email = $self->default_user->mailboxes->inbox->new_email;

    my $until = sub ($secs) {
        DateTime->from_epoch(epoch => time + $secs)
            ->strftime('%Y-%m-%dT%H:%M:%SZ');
    };

    # With maxDelayedSend 0, any hold parameter is invalid, even one that
    # would release immediately.
    my %params = (
        nohold         => {},
        holdfor_zero   => { HOLDFOR   => '0' },
        holdfor_some   => { HOLDFOR   => '60' },
        holduntil_past => { HOLDUNTIL => $until->(-60) },
        holduntil_some => { HOLDUNTIL => $until->(60) },
    );

    $res = $jmap->request([[ 'EmailSubmission/set', {
        create => {
            map {
                $_ => {
                    identityId => $identityid,
                    emailId    => $email->id,
                    envelope   => {
                        mailFrom => {
                            email      => 'from@localhost',
                            parameters => $params{$_},
                        },
                        rcptTo => [ { email => 'rcpt@localhost' } ],
                    },
                },
            } keys %params
        },
    } ]]);

    my $invalid = sub ($param) {
        return {
            type       => 'invalidProperties',
            properties => [ "envelope/mailFrom/parameters/$param" ],
        };
    };

    my $set = $res->single_sentence('EmailSubmission/set')->arguments;
    $self->assert_cmp_deeply(
        {
            created    => { nohold => superhashof({ undoStatus => 'final' }) },
            notCreated => {
                holdfor_zero   => $invalid->('HOLDFOR'),
                holdfor_some   => $invalid->('HOLDFOR'),
                holduntil_past => $invalid->('HOLDUNTIL'),
                holduntil_some => $invalid->('HOLDUNTIL'),
            },
        },
        { map { $_ => $set->{$_} } qw(created notCreated) },
    );
}
