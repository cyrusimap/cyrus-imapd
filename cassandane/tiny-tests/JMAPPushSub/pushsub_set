#!perl
use Cassandane::Tiny;

sub test_pushsub_set
    :needs_component_jmap
{
    my ($self) = @_;

    my $jmap = $self->{jmap};

    xlog $self, "create subscription";
    my $res = $jmap->request([
        ['PushSubscription/get', { accountId => \undef }, 'R0'],
        ['PushSubscription/set', {
            accountId => \undef,
            create => {
                1 => {
                    deviceClientId => 'a889-ffea-910',
                    url => 'https://example.com/push/?device=X8980fc&client=12c6d086',
                    types => [ 'Mailbox', 'Email' ],
                },
            },
        }, 'R1'],
        ['PushSubscription/get', { accountId => \undef, ids => [ '#1' ] }, 'R2'],
    ]);
    $self->assert_cmp_deeply([], $res->sentence(0)->arguments->{list});

    my $created = $res->sentence(1)->arguments->{created}{1};
    $self->assert_not_null($created->{expires});
    my $id = "" . $created->{id};

    xlog $self, "get omits url and keys, and the unverified code";
    $self->assert_cmp_deeply([{
        id => $id,
        deviceClientId => 'a889-ffea-910',
        verificationCode => undef,
        expires => $created->{expires},
        types => [ 'Mailbox', 'Email' ],
    }], $res->sentence(2)->arguments->{list});

    my ($code) =
        map  { $_->{content}{verificationCode} }
        grep { $_->{event} eq 'PushSubscriptionCreated' }
        map  { decode_json($_->{MESSAGE}) }
        grep { $_->{CLASS} eq 'EVENT' } $self->{instance}->getnotify()->@*;
    $self->assert_not_null($code);

    xlog $self, "reject the wrong verification code";
    $res = $jmap->request([
        ['PushSubscription/set', {
            accountId => \undef,
            update => { $id => { verificationCode => 'wrong' } },
        }, 'R1'],
    ]);
    $self->assert_cmp_deeply(['verificationCode'],
        $res->single_sentence->arguments->{notUpdated}{$id}{properties});

    xlog $self, "verify subscription";
    $res = $jmap->request([
        ['PushSubscription/set', {
            accountId => \undef,
            update => { $id => { verificationCode => $code } },
        }, 'R1'],
        ['PushSubscription/get', { accountId => \undef }, 'R2'],
    ]);
    $self->assert_cmp_deeply({ $id => undef },
        $res->sentence(0)->arguments->{updated});
    $self->assert_str_equals($code,
        $res->sentence(1)->arguments->{list}[0]{verificationCode});

    xlog $self, "update subscription, with expires past the limit";
    $res = $jmap->request([
        ['PushSubscription/set', {
            accountId => \undef,
            update => {
                $id => {
                    expires => '2038-01-19T03:14:07Z',
                    types => [ 'EmailSubmission', 'Mailbox', 'Email' ],
                },
            },
        }, 'R1'],
        ['PushSubscription/get', { accountId => \undef }, 'R2'],
    ]);
    my $expires = $res->sentence(0)->arguments->{updated}{$id}{expires};
    $self->assert_not_null($expires);
    $self->assert($expires lt '2038-01-19T03:14:07Z');
    $self->assert_cmp_deeply([{
        id => $id,
        deviceClientId => 'a889-ffea-910',
        verificationCode => $code,
        expires => $expires,
        types => [ 'EmailSubmission', 'Mailbox', 'Email' ],
    }], $res->sentence(1)->arguments->{list});

    xlog $self, "null expires and types reset them to the defaults";
    $res = $jmap->request([
        ['PushSubscription/set', {
            accountId => \undef,
            update => { $id => { expires => undef, types => undef } },
        }, 'R1'],
        ['PushSubscription/get', { accountId => \undef }, 'R2'],
    ]);
    $self->assert_not_null(
        $res->sentence(0)->arguments->{updated}{$id}{expires});
    $self->assert_null($res->sentence(1)->arguments->{list}[0]{types});

    xlog $self, "url and keys are immutable";
    $res = $jmap->request([
        ['PushSubscription/set', {
            accountId => \undef,
            update => {
                $id => {
                    url => 'https://example.com/other',
                    keys => { p256dh => 'x', auth => 'y' },
                },
            },
        }, 'R1'],
    ]);
    $self->assert_cmp_deeply(bag('url', 'keys'),
        $res->single_sentence->arguments->{notUpdated}{$id}{properties});

    xlog $self, "destroy subscription";
    $res = $jmap->request([
        ['PushSubscription/set', { accountId => \undef, destroy => [ $id ] }, 'R1'],
        ['PushSubscription/get', { accountId => \undef }, 'R2'],
    ]);
    $self->assert_cmp_deeply([ $id ], $res->sentence(0)->arguments->{destroyed});
    $self->assert_cmp_deeply([], $res->sentence(1)->arguments->{list});
}
