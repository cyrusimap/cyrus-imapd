#!perl
use Cassandane::Tiny;

sub test_searchfuzzy_capability_none
    :SearchEngineNone
    ($self)
{
    my $imap = $self->{store}->get_client();
    $self->assert_null($imap->capability()->{'search=fuzzy'});

    $self->make_message("I run") || die;

    xlog $self, "FUZZY is accepted and ignored";
    my $uids = $imap->search('fuzzy', 'subject', 'run');
    $self->assert_str_equals('ok', $imap->get_last_completion_response());
    $self->assert_cmp_deeply([1], $uids);

    $uids = $imap->sort('(subject)', 'utf-8', 'fuzzy', 'subject', 'run');
    $self->assert_str_equals('ok', $imap->get_last_completion_response());
    $self->assert_cmp_deeply([1], $uids);

    $uids = $imap->thread('references', 'utf-8', 'fuzzy', 'subject', 'run');
    $self->assert_str_equals('ok', $imap->get_last_completion_response());
    $self->assert_cmp_deeply([[1]], $uids);
}
