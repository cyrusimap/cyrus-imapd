#!perl
use Cassandane::Tiny;

sub test_calendar_changes_maxchanges ($self)
{
    my $jmap = $self->{jmap};

    my $res = $jmap->CallMethods([['Calendar/get', { ids => undef }, 'R1']]);
    my $state = $res->[0][1]{state};

    my @ids;
    for my $name (qw(one two three)) {
        $res = $jmap->CallMethods([
            ['Calendar/set', { create => { c => { name => $name } } }, 'R1'],
        ]);
        push @ids, $res->[0][1]{created}{c}{id};
    }

    xlog $self, "page through the changes one calendar at a time";
    my @created;
    for (1 .. 3) {
        $res = $jmap->CallMethods([
            ['Calendar/changes', { sinceState => $state, maxChanges => 1 },
             'R1'],
        ]);
        $self->assert_num_equals(1, scalar $res->[0][1]{created}->@*);
        push @created, $res->[0][1]{created}->@*;
        $state = $res->[0][1]{newState};
    }
    $self->assert_cmp_deeply(\@ids, \@created);

    $res = $jmap->CallMethods([
        ['Calendar/changes', { sinceState => $state, maxChanges => 1 }, 'R1'],
    ]);
    $self->assert_cmp_deeply([], $res->[0][1]{created});
    $self->assert_equals(JSON::false, $res->[0][1]{hasMoreChanges});
}
