#!perl
use Cassandane::Tiny;

sub test_calendarprincipal_set_update_readonly
    ($self)
{
    my $jmap = $self->default_user->jmap;

    my $get = sub () {
        $jmap->request([[ 'Principal/get', { ids => [ 'cassandane' ] } ]])
             ->single_sentence('Principal/get')->arguments->{list}[0];
    };
    my $orig = $get->();

    # RFC 8620 1.1: a server-set value MUST NOT change
    for my $patch (
        { name               => 'changed' },
        { description        => 'changed' },
        { email              => 'changed@example.com' },
        { type               => 'group' },
        { mayGetAvailability => JSON::false },
        { accountId          => 'changed' },
        { account            => undef },
        { calendarAddress    => 'mailto:changed@example.com' },
    ) {
        my ($prop) = keys %$patch;
        my $res = $jmap->request([[ 'Principal/set', {
            update => { cassandane => $patch },
        } ]]);
        $self->assert_cmp_deeply(
            { cassandane => {
                type => 'invalidProperties', properties => [ $prop ] } },
            $res->single_sentence('Principal/set')->arguments->{notUpdated},
            "patch $prop",
        );
        $self->assert_cmp_deeply($orig, $get->(), "unchanged after $prop");
    }

    # RFC 8620 5.3: they may be sent unchanged
    my %same = %$orig;
    delete $same{timeZone};
    my $res = $jmap->request([[ 'Principal/set', {
        update => {
            cassandane => { %same, timeZone => 'Europe/Berlin' },
        },
    } ]]);
    $self->assert_cmp_deeply(
        [ 'cassandane' ],
        [ keys $res->single_sentence('Principal/set')->arguments->{updated}->%* ],
    );
    $self->assert_str_equals('Europe/Berlin', $get->()->{timeZone});

    # ... including the whole object as Principal/get returns it
    $res = $jmap->request([[ 'Principal/set', {
        update => { cassandane => $get->() },
    } ]]);
    $self->assert_cmp_deeply(
        [ 'cassandane' ],
        [ keys $res->single_sentence('Principal/set')->arguments->{updated}->%* ],
    );
}
