#!perl
use Cassandane::Tiny;

sub test_calendareventnotification_changes
    :min_version_3_3 :needs_component_sieve
    ($self)
{
    my $jmap = $self->default_user->jmap;
    my $default_cal_id = $self->default_user->calendars->default->id;


    # Need to share calendar, otherwise no notification is created

    my $admin = $self->{adminstore}->get_client();
    $admin->create("user.manifold");
    my $manifold_user = $self->{instance}->create_user_without_setup('manifold');
    my $mantalk = $manifold_user->caldav;
    my $manjmap = $manifold_user->jmap;
    $manjmap->DefaultUsing([
        'urn:ietf:params:jmap:core',
        'urn:ietf:params:jmap:calendars',
        'urn:ietf:params:jmap:principals',
        'https://cyrusimap.org/ns/jmap/calendars',
        'https://cyrusimap.org/ns/jmap/jscalendarbis',
    ]);

    my $res = $jmap->CallMethods([
        ['Calendar/set', {
            update => {
                $default_cal_id => {
                    shareWith => {
                        manifold => {
                            mayReadFreeBusy => JSON::true,
                            mayReadItems => JSON::true,
                            mayUpdatePrivate => JSON::true,
                            mayWriteOwn => JSON::true,
                            mayShare => JSON::false
                        },
                    },
                },
            },
        }, 'R1'],
    ]);
    $self->assert(exists $res->[0][1]{updated}{$default_cal_id});

    $res = $jmap->CallMethods([
        ['CalendarEventNotification/get', {
        }, 'R1'],
    ]);
    $self->assert_cmp_deeply([], $res->[0][1]{list});
    my $state = $res->[0][1]{state};
    $self->assert_not_null($state);

    $res = $jmap->CallMethods([
        ['CalendarEventNotification/changes', {
            sinceState => $state,
        }, 'R1'],
    ]);
    $self->assert_str_equals($state, $res->[0][1]{oldState});
    $self->assert_str_equals($state, $res->[0][1]{newState});
    $self->assert_equals(JSON::false, $res->[0][1]{hasMoreChanges});
    $self->assert_cmp_deeply([], $res->[0][1]{created});
    $self->assert_cmp_deeply([], $res->[0][1]{updated});
    $self->assert_cmp_deeply([], $res->[0][1]{destroyed});

    xlog "create notification that cassandane will see";

    xlog $self, "install a sieve script to process iMIP";
    $self->{instance}->install_sieve_script(<<EOF
require ["body", "variables", "imap4flags", "vnd.cyrus.imip"];
if body :content "text/calendar" :contains "\nMETHOD:" {
    processimip :deletecanceled :outcome "outcome";
}
EOF
    );

    my $imip = <<'EOF';
Date: Wed, 28 Sep 2016 12:00:00 +0000
From: iTIP Sender <itipsender@local>
To: Cassandane <cassandane@example.com>
Message-ID: <40d6fe3c-6a51-489e-823e-3ea22f427a3e@local>
Content-Type: text/calendar; method=REQUEST; component=VEVENT
X-Cassandane-Unique: 40d6fe3c-6a51-489e-823e-3ea22f427a3e

BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Apple Inc.//Mac OS X 10.9.5//EN
CALSCALE:GREGORIAN
METHOD:REQUEST
BEGIN:VEVENT
DTSTART:20160928T160000Z
DURATION:PT1H
UID:40d6fe3c-6a51-489e-823e-3ea22f427a3e
DTSTAMP:20150928T132434Z
CREATED:20150928T125212Z
SUMMARY:testitip
LAST-MODIFIED:20150928T132434Z
SEQUENCE:0
ORGANIZER;CN=iTIP Sender:MAILTO:itipsender@local
ATTENDEE;PARTSTAT=NEEDS-ACTION;RSVP=TRUE:MAILTO:cassandane@example.com
END:VEVENT
END:VCALENDAR
EOF
    $self->{instance}->deliver(Cassandane::Message->new(raw => $imip));

    $res = $jmap->CallMethods([
        ['CalendarEventNotification/changes', {
            sinceState => $state,
        }, 'R1'],
    ]);
    $self->assert_str_equals($state, $res->[0][1]{oldState});
    $self->assert_str_not_equals($state, $res->[0][1]{newState});
    $self->assert_equals(JSON::false, $res->[0][1]{hasMoreChanges});
    $self->assert_num_equals(1, scalar @{$res->[0][1]{created}});
    $self->assert_cmp_deeply([], $res->[0][1]{updated});
    $self->assert_cmp_deeply([], $res->[0][1]{destroyed});

    my $notifId = $res->[0][1]{created}[0];
    my $oldState = $state;
    $state = $res->[0][1]{newState};

    $res = $jmap->CallMethods([
        ['CalendarEventNotification/set', {
            destroy => [$notifId],
        }, 'R1'],
    ]);
    $self->assert_cmp_deeply([$notifId], $res->[0][1]{destroyed});

    $res = $jmap->CallMethods([
        ['CalendarEventNotification/changes', {
            sinceState => $state,
        }, 'R1'],
    ]);
    $self->assert_str_equals($state, $res->[0][1]{oldState});
    $self->assert_str_not_equals($state, $res->[0][1]{newState});
    $self->assert_cmp_deeply([], $res->[0][1]{created});
    $self->assert_cmp_deeply([], $res->[0][1]{updated});
    $self->assert_cmp_deeply([$notifId], $res->[0][1]{destroyed});
}
