#!perl
use Cassandane::Tiny;

# A sharee may not write a non-public event in a calendar they do not own,
# whatever rights they have on it: they may neither create one nor turn a public
# event into one, and they may not touch one that the owner created.

# Share the owner's default calendar with sharee, granting every right short of
# administering the calendar.
my sub share_calendar ($self)
{
    my $sharee = $self->{instance}->create_user('sharee');

    xlog $self, "share the default calendar with sharee";
    $self->default_user->calendars->default->share_with(sharee => [qw(
        mayReadItems mayWriteAll mayUpdatePrivate mayRSVP mayDelete
    )]);

    return $sharee;
}

# The properties of an event in the owner's default calendar, for a sharee to
# send in a CalendarEvent/set of their own.
my sub event_props ($self, %props)
{
    return {
        version => '2.0',
        calendarIds => {
            $self->default_user->calendars->default->id => JSON::true,
        },
        title => 'an event',
        start => '2026-08-01T09:00:00',
        duration => 'PT1H',
        timeZone => 'Etc/UTC',
        %props,
    };
}

# Create an event of $privacy in the owner's default calendar, as the owner.
my sub create_event ($self, $privacy)
{
    xlog $self, "create a $privacy event";
    return $self->default_user->calendars->default
                ->create_event({ privacy => $privacy });
}

# The owner may set any privacy on an event of their own, a sharee may not set
# one other than public.
sub test_calendarevent_set_privacy__nonpublic
    ($self)
{
    my $sharee = share_calendar($self);

    xlog $self, "the owner creates a secret event";
    create_event($self, 'secret');

    xlog $self, "sharee may only create the public event";
    my $set = $sharee->jmap->request([[
        'CalendarEvent/set' => {
            accountId => 'cassandane',
            create => {
                public => event_props($self, privacy => 'public'),
                private => event_props($self, privacy => 'private'),
            },
        },
    ]])->single_sentence('CalendarEvent/set')->as_set;

    my $public_id = q{} . $set->created_id('public');
    $self->assert_not_null($set->created->{public});
    $self->assert_cmp_deeply(superhashof({
        type => 'invalidProperties',
        properties => ['privacy'],
    }), $set->create_errors->{private});

    xlog $self, "sharee may not turn their public event non-public";
    $set = $sharee->jmap->request([[
        'CalendarEvent/set' => {
            accountId => 'cassandane',
            update => {
                $public_id => {
                    privacy => 'secret',
                },
            },
        },
    ]])->single_sentence('CalendarEvent/set')->as_set;

    $self->assert_cmp_deeply(superhashof({
        type => 'invalidProperties',
        properties => ['privacy'],
    }), $set->update_errors->{$public_id});
}

my sub assert_calendarevent_set_privacy ($self, $privacy, $want_error)
{
    $self->assert_str_not_equals('public', $privacy);

    my $sharee = share_calendar($self);
    my $event_id = create_event($self, $privacy)->id;

    xlog $self, "sharee can neither update nor destroy the $privacy event";
    my ($update, $destroy) = $sharee->jmap->request([
        [ 'CalendarEvent/set' => {
            accountId => 'cassandane',
            update => {
                $event_id => {
                    start => '2026-08-02T02:00:00',
                },
            },
        } ],
        [ 'CalendarEvent/set' => {
            accountId => 'cassandane',
            destroy => [ $event_id ],
        } ],
    ])->assert_n_sentences(2);

    $self->assert_str_equals($want_error,
        $update->as_set->update_errors->{$event_id}{type});
    $self->assert_str_equals($want_error,
        $destroy->as_set->destroy_errors->{$event_id}{type});
}

sub test_calendarevent_set_privacy__write_private
    ($self)
{
    assert_calendarevent_set_privacy($self, 'private', 'forbidden');
}

sub test_calendarevent_set_privacy__write_secret
    ($self)
{
    assert_calendarevent_set_privacy($self, 'secret', 'notFound');
}
