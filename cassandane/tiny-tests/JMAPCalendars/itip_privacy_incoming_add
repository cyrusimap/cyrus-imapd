#!perl
use Cassandane::Tiny;

my sub deliver_imip ($self, $ical)
{
    my $msg = $self->{gen}->generate(
        from => Cassandane::Address->new(localpart => 'sender',
                                         domain => 'example.net'),
        to => Cassandane::Address->new(localpart => 'cassandane',
                                       domain => 'example.com'),
        mime_type => 'text/calendar; method=REQUEST; component=VEVENT',
        body => $ical,
    );

    $self->{instance}->deliver($msg);
}

sub test_itip_privacy_incoming_add
    :needs_component_sieve
    ($self)
{
    my $user = $self->default_user;
    my $jmap = $user->jmap;

    my $uid = guid_string();
    my $organizer = 'organizer@example.net';
    my $attendee = 'cassandane@example.com';

    xlog $self, "Install a sieve script to process iMIP";
    $self->{instance}->install_sieve_script(<<~"EOF");
    require ["body", "variables", "imap4flags", "vnd.cyrus.imip"];
    if body :content "text/calendar" :contains "\nMETHOD:" {
        processimip :deletecanceled :outcome "outcome";
    }
    EOF

    xlog $self, "Organizer sends invite with CLASS:PRIVATE";
    deliver_imip($self, <<~"EOF");
    BEGIN:VCALENDAR
    VERSION:2.0
    PRODID:-//Apple Inc.//Mac OS X 10.10.4//EN
    METHOD:REQUEST
    BEGIN:VEVENT
    CREATED:20210923T034327Z
    UID:$uid
    SUMMARY:test
    CLASS:PRIVATE
    DTSTART;TZID=America/New_York:20210923T153000
    DURATION:PT1H
    DTSTAMP:20210923T034327Z
    RRULE:FREQ=DAILY;COUNT=3
    SEQUENCE:0
    ORGANIZER:MAILTO:$organizer
    ATTENDEE;RSVP=TRUE;PARTSTAT=NEEDS-ACTION;X-JMAP-ID=cassandane:MAILTO:$attendee
    END:VEVENT
    END:VCALENDAR
    EOF

    my $event_id = $jmap->request([
        [ 'CalendarEvent/get' => { properties => ['id'] } ],
    ])->single_sentence('CalendarEvent/get')->arguments->{list}[0]{id};
    $self->assert_not_null($event_id);
    $self->assert_str_equals('private',
        $user->calendarevents->get($event_id)->privacy);

    xlog $self, "Organizer adds instance with different CLASS value";
    deliver_imip($self, <<~"EOF");
    BEGIN:VCALENDAR
    VERSION:2.0
    PRODID:-//Apple Inc.//Mac OS X 10.10.4//EN
    METHOD:ADD
    BEGIN:VEVENT
    CREATED:20210923T034327Z
    UID:$uid
    SUMMARY:test
    CLASS:CONFIDENTIAL
    DTSTART;TZID=America/New_York:20210927T153000
    DURATION:PT1H
    DTSTAMP:20210923T034327Z
    SEQUENCE:1
    ORGANIZER:MAILTO:$organizer
    ATTENDEE;RSVP=TRUE;PARTSTAT=NEEDS-ACTION;X-JMAP-ID=cassandane:MAILTO:$attendee
    END:VEVENT
    END:VCALENDAR
    EOF

    xlog $self, "Assert that instance is added but original CLASS value preserved";
    my $event = $user->calendarevents->get($event_id);
    $self->assert_not_null($event->recurrenceOverrides->{'2021-09-27T15:30:00'});
    $self->assert_str_equals('private', $event->privacy);
}
