#!perl
use Cassandane::Tiny;

sub test_calendarevent_set_method
    :min_version_3_7
    ($self)
{
    my $jmap = $self->default_user->jmap;
    my $default_cal_id = $self->default_user->calendars->default->id;

    xlog "method on main event is rejected";
    my $res = $jmap->CallMethods([
        ['CalendarEvent/set', {
            create => {
                event => {
                    version => '2.0',
                    calendarIds => {
                        $default_cal_id => JSON::true,
                    },
                    start => '2022-01-28T09:00:00',
                    timeZone => 'Etc/UTC',
                    duration => 'PT1H',
                    title => 'event',
                    method => 'request',
                    organizerCalendarAddress => 'mailto:cassandane@example.com',
                    participants => {
                        someone => {
                            calendarAddress => 'mailto:someone@example.com',
                        },
                    },
                },
            },
        }, 'R1'],
    ]);
    $self->assert_str_equals('invalidProperties',
        $res->[0][1]{notCreated}{event}{type});
    $self->assert_cmp_deeply(['method'],
        $res->[0][1]{notCreated}{event}{properties});

    xlog "method on override event is rejected";
    my %event = (
        version => '2.0',
        calendarIds => {
            $default_cal_id => JSON::true,
        },
        start => '2022-01-28T09:00:00',
        timeZone => 'Etc/UTC',
        duration => 'PT1H',
        title => 'event',
        organizerCalendarAddress => 'mailto:cassandane@example.com',
        participants => {
            someone => {
                calendarAddress => 'mailto:someone@example.com',
            },
        },
        recurrenceRule => {
            frequency => 'daily',
        },
    );
    $res = $jmap->CallMethods([
        ['CalendarEvent/set', {
            create => {
                bad => {
                    %event,
                    recurrenceOverrides => {
                        '2022-01-29T09:00:00' => {
                            title => 'override',
                            method => 'request',
                        },
                    },
                },
                event => \%event,
            },
        }, 'R1'],
    ]);
    $self->assert_cmp_deeply({
        type => 'invalidProperties',
        properties => ['recurrenceOverrides/2022-01-29T09:00:00/method'],
    }, $res->[0][1]{notCreated}{bad});
    my $eventId = $res->[0][1]{created}{event}{id};
    $self->assert_not_null($eventId);

    xlog "can't set method in /update either";
    $res = $jmap->CallMethods([
        ['CalendarEvent/set', {
            update => {
                $eventId => {
                    method => 'request',
                },
            },
        }, 'R1'],
    ]);
    $self->assert_str_equals('invalidProperties',
        $res->[0][1]{notUpdated}{$eventId}{type});
    $self->assert_cmp_deeply(['method'],
        $res->[0][1]{notUpdated}{$eventId}{properties});
}
