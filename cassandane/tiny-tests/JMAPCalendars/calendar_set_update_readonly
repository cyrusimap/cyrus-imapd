#!perl
use Cassandane::Tiny;

sub test_calendar_set_update_readonly
    ($self)
{
    my $jmap = $self->default_user->jmap;

    my $id = $jmap->request([[ 'Calendar/set', {
        create => { 1 => { name => 'foo' } },
    } ]])->single_sentence('Calendar/set')->arguments->{created}{1}{id};
    $self->assert_not_null($id);

    my @props = qw( isDefault myRights mailboxUniqueId x-href x-compactId );
    my $get = sub (@props) {
        $jmap->request([[ 'Calendar/get', {
            ids => [ $id ],
            (@props ? (properties => \@props) : ()),
        } ]])->single_sentence('Calendar/get')->arguments->{list}[0];
    };
    my $orig = $get->();

    # RFC 8620 1.1: a server-set value MUST NOT change
    for my $patch (
        { isDefault         => JSON::true },
        { myRights          => { %{ $orig->{myRights} }, mayDelete => JSON::false } },
        { 'myRights/mayDelete' => JSON::false },
        { mailboxUniqueId   => 'changed' },
        { 'x-href'          => '/dav/calendars/changed' },
        { 'x-compactId'     => 'changed' },
    ) {
        my ($prop) = map { s{/.*}{}r } keys %$patch;
        my $res = $jmap->request([[ 'Calendar/set', {
            update => { $id => $patch },
        } ]]);
        $self->assert_cmp_deeply(
            { $id => { type => 'invalidProperties', properties => [ $prop ] } },
            $res->single_sentence('Calendar/set')->arguments->{notUpdated},
            "patch $prop",
        );
        $self->assert_cmp_deeply($orig, $get->(), "unchanged after $prop");
    }

    # RFC 8620 5.3: they may be sent unchanged
    my %same = map { $_ => $orig->{$_} } @props;
    my $res = $jmap->request([[ 'Calendar/set', {
        update => { $id => { %same, name => 'bar' } },
    } ]]);
    $self->assert_cmp_deeply(
        { $id => undef },
        $res->single_sentence('Calendar/set')->arguments->{updated},
    );
    $self->assert_str_equals('bar', $get->('name')->{name});

    # ... including the whole object as Calendar/get returns it by default
    $res = $jmap->request([[ 'Calendar/set', {
        update => { $id => $get->() },
    } ]]);
    $self->assert_cmp_deeply(
        { $id => undef },
        $res->single_sentence('Calendar/set')->arguments->{updated},
    );
}
