#!perl
use Cassandane::Tiny;

sub test_calendarevent_set_organizer
    ($self)
{
    my $jmap = $self->default_user->jmap;
    my $default_cal_id = $self->default_user->calendars->default->id;

    my $res = $jmap->CallMethods([
        ['CalendarEvent/set', {
            create => {
                eventReplyTo => {
                    version => '2.0',
                    calendarIds => {
                        $default_cal_id => JSON::true,
                    },
                    start => '2022-01-28T09:00:00',
                    timeZone => 'Etc/UTC',
                    duration => 'PT1H',
                    title => 'event',
                    organizerCalendarAddress => 'mailto:myreplyto@example.com',
                    participants => {
                        someone => {
                            calendarAddress => 'mailto:someone@example.com',
                        },
                    },
                },
                eventNoReplyTo => {
                    version => '2.0',
                    calendarIds => {
                        $default_cal_id => JSON::true,
                    },
                    start => '2022-01-28T10:00:00',
                    timeZone => 'Etc/UTC',
                    duration => 'PT1H',
                    title => 'event',
                    participants => {
                        someone => {
                            calendarAddress => 'mailto:someone@example.com',
                        },
                    },
                },
                eventReplyToNoParticipants => {
                    version => '2.0',
                    calendarIds => {
                        $default_cal_id => JSON::true,
                    },
                    start => '2022-01-28T11:00:00',
                    timeZone => 'Etc/UTC',
                    duration => 'PT1H',
                    title => 'event',
                    organizerCalendarAddress => 'mailto:cassandane@example.com',
                },
                eventNoScheduling => {
                    version => '2.0',
                    calendarIds => {
                        $default_cal_id => JSON::true,
                    },
                    start => '2022-01-28T12:00:00',
                    timeZone => 'Etc/UTC',
                    duration => 'PT1H',
                    title => 'event',
                },
            },
        }, 'R1'],
        ['CalendarEvent/get', {
            ids => ['#eventReplyTo'],
            properties => ['organizerCalendarAddress'],
        }, 'R2'],
        ['CalendarEvent/get', {
            ids => ['#eventNoReplyTo'],
            properties => ['organizerCalendarAddress'],
        }, 'R3'],
    ]);

    xlog "Preserve client-set organizerCalendarAddress";
    $self->assert_str_equals('mailto:myreplyto@example.com',
        $res->[1][1]{list}[0]{organizerCalendarAddress});

    xlog "Use server-set organizerCalendarAddress if not set by client";
    $self->assert_str_equals('mailto:cassandane@example.com',
        $res->[0][1]{created}{eventNoReplyTo}{organizerCalendarAddress});
    $self->assert_str_equals('mailto:cassandane@example.com',
        $res->[2][1]{list}[0]{organizerCalendarAddress});

    xlog "Reject event with organizerCalendarAddress but no participants";
    $self->assert_str_equals('invalidProperties',
        $res->[0][1]{notCreated}{eventReplyToNoParticipants}{type});
    $self->assert_cmp_deeply(['participants'],
        $res->[0][1]{notCreated}{eventReplyToNoParticipants}{properties});

    xlog "Use server-set organizerCalendarAddress when participants added in update";
    my $eventId = $res->[0][1]{created}{eventNoScheduling}{id};
    $res = $jmap->CallMethods([
        ['CalendarEvent/set', {
            update => {
                $eventId => {
                    participants => {
                        someone => {
                            calendarAddress => 'mailto:someone@example.com',
                        },
                    },
                },
            },
        }, 'R1'],
        ['CalendarEvent/get', {
            ids => [$eventId],
            properties => ['organizerCalendarAddress'],
        }, 'R2'],
    ]);
    $self->assert_str_equals('mailto:cassandane@example.com',
        $res->[0][1]{updated}{$eventId}{organizerCalendarAddress});
    $self->assert_str_equals('mailto:cassandane@example.com',
        $res->[1][1]{list}[0]{organizerCalendarAddress});

    xlog "Use server-set organizerCalendarAddress if first participant is unscheduled";
    # Sort keys so that participant "a" is sent before "b".
    $jmap->_json_codec->canonical(1);
    $res = $jmap->CallMethods([
        ['CalendarEvent/set', {
            create => {
                eventFirstUnscheduled => {
                    version => '2.0',
                    calendarIds => {
                        $default_cal_id => JSON::true,
                    },
                    start => '2022-01-28T13:00:00',
                    timeZone => 'Etc/UTC',
                    duration => 'PT1H',
                    title => 'event',
                    participants => {
                        a => {
                            name => 'unscheduled',
                        },
                        b => {
                            calendarAddress => 'mailto:someone@example.com',
                        },
                    },
                },
            },
        }, 'R1'],
    ]);
    $self->assert_str_equals('mailto:cassandane@example.com',
        $res->[0][1]{created}{eventFirstUnscheduled}{organizerCalendarAddress});
    $jmap->_json_codec->canonical(0);

    xlog "Create recurring event without participants";
    my $recurring = $self->default_user->calendarevents->create({
        start => '2022-01-28T14:00:00',
        recurrenceRule => {
            frequency => 'daily',
            count => 3,
        },
    });
    $eventId = $recurring->id;
    my $instanceId = encode_eventid($eventId, '20220129T140000');

    xlog "Reject participants added only to a recurrence override";
    $res = $jmap->request([
        ['CalendarEvent/set', {
            update => {
                $eventId => {
                    recurrenceOverrides => {
                        '2022-01-29T14:00:00' => {
                            participants => {
                                someone => {
                                    calendarAddress => 'mailto:someone@example.com',
                                },
                            },
                        },
                    },
                },
                $instanceId => {
                    participants => {
                        someone => {
                            calendarAddress => 'mailto:someone@example.com',
                        },
                    },
                },
            },
        }],
    ]);
    $self->assert_cmp_deeply({
        $eventId => superhashof({
            type => 'invalidProperties',
            properties => ['recurrenceOverrides/2022-01-29T14:00:00/participants'],
        }),
        $instanceId => superhashof({
            type => 'invalidProperties',
            properties => ['recurrenceOverrides/2022-01-29T14:00:00/participants'],
        }),
    }, $res->single_sentence('CalendarEvent/set')->as_set->update_errors);

    xlog "Use server-set organizerCalendarAddress when participants added to main event and override";
    $recurring->update({
        participants => {
            someone => {
                calendarAddress => 'mailto:someone@example.com',
            },
        },
        recurrenceOverrides => {
            '2022-01-29T14:00:00' => {
                participants => {
                    other => {
                        calendarAddress => 'mailto:other@example.com',
                    },
                },
            },
        },
    });
    $self->assert_str_equals('mailto:cassandane@example.com',
        $recurring->organizerCalendarAddress);
}
