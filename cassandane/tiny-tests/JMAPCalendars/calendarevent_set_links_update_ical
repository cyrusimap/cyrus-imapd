sub test_calendarevent_set_links_update_ical_attach_binary
    ($self)
{
    assert_calendarevent_set_links_update_ical($self,
        orig_ical => 'ATTACH;VALUE=BINARY;ENCODING=BASE64;FMTTYPE=text/plain',
        orig_value => 'aGVsbG8=',
        patch => { title => 'updated' },
        want_value => 'aGVsbG8=',
        want_ical => {
            attach => {
                encoding => [ 'BASE64' ],
                fmttype => [ 'text/plain' ],
                value => [ 'BINARY' ],
            },
        });
}

