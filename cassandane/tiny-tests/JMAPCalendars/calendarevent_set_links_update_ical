        orig_ical => 'ATTACH;X-FOO=bar',
        patch => {
            'links/link1/href' => $LINK_HREF,
            'links/link1/rel' => 'icon',
            'links/link1/display' => { badge => JSON::true },
        },
        want_ical => {
            image => {
                display => [ 'BADGE' ],
                'x-foo' => [ 'bar' ],
            },
        });
}

