#!perl
use Cassandane::Tiny;

# Invariant: utcEnd must not be set together with duration, even if they
# agree.
sub test_calendarevent_set_utcend_with_duration
    ($self)
{
    my $user = $self->default_user;
    my $jmap = $user->jmap;

    my $id = $user->calendarevents->create({
        title => 'event',
        start => '2024-05-01T09:00:00',
        timeZone => 'Etc/UTC',
        duration => 'PT1H',
    })->id;

    my $res = $jmap->request([
        [ 'CalendarEvent/set' => {
            create => {
                bad => {
                    version => '2.0',
                    calendarIds => {
                        $user->calendars->default->id => JSON::true,
                    },
                    title => 'event',
                    utcStart => '2024-05-01T09:00:00Z',
                    timeZone => 'Etc/UTC',
                    duration => 'PT1H',
                    utcEnd => '2024-05-01T10:00:00Z',
                },
            },
            update => {
                $id => {
                    utcStart => '2024-05-01T09:00:00Z',
                    duration => 'PT2H',
                    utcEnd => '2024-05-01T11:00:00Z',
                },
            },
        } ],
    ]);
    my $set = $res->single_sentence('CalendarEvent/set')->as_set;
    $self->assert_cmp_deeply({
        bad => {
            type => 'invalidProperties',
            properties => ['utcEnd'],
        },
    }, $set->create_errors);
    $self->assert_cmp_deeply({
        $id => {
            type => 'invalidProperties',
            properties => ['utcEnd'],
        },
    }, $set->update_errors);
}
