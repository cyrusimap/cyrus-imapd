# Cyrus ignores CLASS in a recurrence override: privacy is a property of the
# whole calendar object, not of a single instance. So an override that does not
# repeat the CLASS of its main event must not disclose its details either.
my sub put_private_override ($self, $sharer)
{
    put_ical($self, $sharer,
        'BEGIN:VEVENT',
        'UID:2a358cee-6489-4f14-a57f-c104db4b8b4c',
        'DTSTAMP:20150806T234327Z',
        'DTSTART;TZID=Europe/Vienna:20200805T090000',
        'DURATION:PT1H',
        'RRULE:FREQ=WEEKLY;COUNT=2',
        'SUMMARY:the title',
        'STATUS:CONFIRMED',
        'CLASS:PRIVATE',
        'SEQUENCE:0',
        'END:VEVENT',
        'BEGIN:VEVENT',
        'UID:2a358cee-6489-4f14-a57f-c104db4b8b4c',
        'RECURRENCE-ID;TZID=Europe/Vienna:20200812T090000',
        'DTSTAMP:20150806T234327Z',
        'DTSTART;TZID=Europe/Vienna:20200812T090000',
        'DURATION:PT1H',
        'SUMMARY:the override title',
        'STATUS:CONFIRMED',
        'SEQUENCE:0',
        'END:VEVENT',
    );
}

sub test_calendarprincipal_getavailability_privacy__private_override_sharee
    ($self)
{
    my $sharer = $self->{instance}->create_user('sharer');
    $sharer->calendars->default->share_with(cassandane => [qw( mayReadItems )]);
    put_private_override($self, $sharer);

    $self->assert_cmp_deeply([{
        utcStart => '2020-08-05T07:00:00Z',
        utcEnd => '2020-08-05T08:00:00Z',
        busyStatus => 'confirmed',
        event => undef,
    }, {
        utcStart => '2020-08-12T07:00:00Z',
        utcEnd => '2020-08-12T08:00:00Z',
        busyStatus => 'confirmed',
        event => undef,
    }], get_availability($self, $self->default_user));
}

