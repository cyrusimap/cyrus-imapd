sub test_calendarprincipal_getavailability_privacy__secret_sharee
    ($self)
{
    my $sharer = $self->{instance}->create_user('sharer');
    $sharer->calendars->default->share_with(cassandane => [qw( mayReadItems )]);
    create_event($self, $sharer, privacy => 'secret');

    xlog $self, "the event contributes no busy time at all";
    $self->assert_cmp_deeply([], get_availability($self, $self->default_user));
}

