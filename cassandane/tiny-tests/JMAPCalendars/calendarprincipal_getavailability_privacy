#!perl
use Cassandane::Tiny;

# A secret event must not contribute busy time to availability, and the
# details of a non-public event must never be disclosed. This applies to
# sharees only, the owner of the calendar sees their events in full.

# Returns the availability of the sharer, as seen by $user.
my sub get_availability ($self, $user)
{
    return $user->jmap->request([[
        'Principal/getAvailability' => {
            id => 'sharer',
            utcStart => '2020-08-01T00:00:00Z',
            utcEnd => '2020-09-01T00:00:00Z',
            showDetails => JSON::true,
            eventProperties => ['start', 'title'],
        },
    ]])->single_sentence('Principal/getAvailability')->arguments->{list};
}

my sub create_event ($self, $sharer, %props)
{
    $sharer->calendars->default->create_event({
        title => 'the title',
        start => '2020-08-05T09:00:00',
        timeZone => 'Europe/Vienna',
        duration => 'PT1H',
        status => 'confirmed',
        %props,
    });
}

# PUT the VEVENTs as the sharer's "event.ics" resource. The tests below need
# CLASS in one VEVENT but not in another, which cannot be expressed in a
# CalendarEvent/set.
my sub put_ical ($self, $sharer, @vevent_lines)
{
    $sharer->caldav->Request('PUT', 'Default/event.ics',
        join("\r\n",
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//Apple Inc.//Mac OS X 10.10.4//EN',
            @vevent_lines,
            'END:VCALENDAR',
        ) . "\r\n", 'Content-Type' => 'text/calendar');
}

sub test_calendarprincipal_getavailability_privacy__public_sharee
    ($self)
{
    my $sharer = $self->{instance}->create_user('sharer');
    $sharer->calendars->default->share_with(cassandane => [qw( mayReadItems )]);
    create_event($self, $sharer, privacy => 'public');

    $self->assert_cmp_deeply([{
        utcStart => '2020-08-05T07:00:00Z',
        utcEnd => '2020-08-05T08:00:00Z',
        busyStatus => 'confirmed',
        event => {
            start => '2020-08-05T09:00:00',
            title => 'the title',
        },
    }], get_availability($self, $self->default_user));
}

sub test_calendarprincipal_getavailability_privacy__private_sharee
    ($self)
{
    my $sharer = $self->{instance}->create_user('sharer');
    $sharer->calendars->default->share_with(cassandane => [qw( mayReadItems )]);
    create_event($self, $sharer, privacy => 'private');

    xlog $self, "the event is busy, but discloses no details";
    $self->assert_cmp_deeply([{
        utcStart => '2020-08-05T07:00:00Z',
        utcEnd => '2020-08-05T08:00:00Z',
        busyStatus => 'confirmed',
        event => undef,
    }], get_availability($self, $self->default_user));
}

