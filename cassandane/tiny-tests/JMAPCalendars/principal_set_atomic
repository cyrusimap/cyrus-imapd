#!perl
use Cassandane::Tiny;

sub test_principal_set_atomic ($self)
{
    my $jmap = $self->default_user->new_jmaptester;
    $jmap->AddUsing('urn:ietf:params:jmap:conditional');

    my sub timezone () {
        my $res = $jmap->request([
            [ 'Principal/get', {
                ids => [ 'cassandane' ], properties => [ 'timeZone' ],
            } ],
        ]);
        return $res->single_sentence('Principal/get')
                   ->arguments->{list}[0]{timeZone};
    }

    xlog $self, "an atomic timeZone update applies";
    my $res = $jmap->request([
        [ 'Principal/set', {
            atomic => JSON::true,
            update => { cassandane => { timeZone => 'Europe/London' } },
        } ],
    ]);
    $self->assert_cmp_deeply(
        { cassandane => {} },
        $res->single_sentence('Principal/set')->arguments->{updated},
    );
    $self->assert_str_equals('Europe/London', timezone());

    xlog $self, "an invalid change fails the whole method";
    $res = $jmap->request([
        [ 'Principal/set', {
            atomic  => JSON::true,
            update  => { cassandane => { timeZone => 'Asia/Tokyo' } },
            destroy => [ 'other' ],
        } ],
    ]);
    $self->assert_cmp_deeply(
        {
            type         => 'atomicFailure',
            notDestroyed => { other => { type => 'forbidden' } },
        },
        $res->single_sentence('error')->arguments,
    );
    $res = $jmap->request([
        [ 'Principal/set', {
            atomic => JSON::true,
            update => {
                cassandane => { timeZone => 'Not/AZone' },
                other      => { timeZone => 'Asia/Tokyo' },
            },
        } ],
    ]);
    $self->assert_cmp_deeply(
        {
            type       => 'atomicFailure',
            notUpdated => {
                cassandane => {
                    type       => 'invalidProperties',
                    properties => [ 'timeZone' ],
                },
                other => { type => 'forbidden' },
            },
        },
        $res->single_sentence('error')->arguments,
    );
    $self->assert_str_equals('Europe/London', timezone());

    $res = $jmap->request([
        [ 'ParticipantIdentity/get', { properties => [ 'calendarAddress' ] } ],
    ]);
    my $identity = $res->single_sentence('ParticipantIdentity/get')
                       ->arguments->{list}[0];
    my $identityId = $identity->{id};
    $self->assert_not_null($identityId);

    xlog $self, "an atomic ParticipantIdentity/set without changes succeeds";
    $res = $jmap->request([
        [ 'ParticipantIdentity/set', {
            atomic        => JSON::true,
            ifUnchangedBy => { $identityId => {
                calendarAddress => $identity->{calendarAddress},
            } },
        } ],
    ]);
    my $args = $res->single_sentence('ParticipantIdentity/set')->arguments;
    $self->assert_null($args->{notCreated});
    $self->assert_null($args->{notUpdated});
    $self->assert_null($args->{notDestroyed});

    xlog $self, "an atomic ParticipantIdentity/set with a change fails";
    $res = $jmap->request([
        [ 'ParticipantIdentity/set', {
            atomic => JSON::true,
            create => { n => { calendarAddress => 'mailto:n@example.com' } },
        } ],
    ]);
    $self->assert_cmp_deeply(
        {
            type       => 'atomicFailure',
            notCreated => { n => { type => 'forbidden' } },
        },
        $res->single_sentence('error')->arguments,
    );
}
