#!perl
use Cassandane::Tiny;

# Reusing the UID of a destroyed event is allowed, but the destroyed event
# must not hide the live event that now holds the UID: a third create of the
# same event duplicates the live one, and must not add a second resource.

my sub uid_resources ($user, $uid)
{
    my $res = $user->jmap->request([
        ['CalendarEvent/get', {
            ids        => undef,
            properties => ['uid', 'x-href'],
        }, 'R1'],
    ]);

    my %resource;
    for my $event ($res->single_sentence('CalendarEvent/get')
                        ->arguments->{list}->@*) {
        next if $event->{uid} ne $uid;
        $resource{$event->{'x-href'}} = 1;
    }

    return [sort keys %resource];
}

my sub create_event ($user, $calendar, $uid, $title)
{
    my $res = $user->jmap->request([
        ['CalendarEvent/set', {
            create => {
                event => {
                    version     => '2.0',
                    uid         => $uid,
                    calendarIds => { $calendar->id => JSON::true },
                    title       => $title,
                    start       => '2026-02-02T02:02:02',
                    timeZone    => 'Etc/UTC',
                    duration    => 'PT1H',
                },
            },
        }, 'R1'],
    ]);

    return $res->single_sentence('CalendarEvent/set')->arguments;
}

sub test_calendarevent_set_uid_after_destroy ($self)
{
    my $user = $self->default_user;
    my $calendar = $user->calendars->default;
    my $uid = 'event1uid';

    xlog $self, "create and destroy an event";
    $calendar->create_event({ uid => $uid, title => 'first' })->destroy;

    xlog $self, "create an event with the uid of the destroyed event";
    my $res = create_event($user, $calendar, $uid, 'second');
    $self->assert_not_null($res->{created}{event});

    xlog $self, "create another event with the same uid";
    create_event($user, $calendar, $uid, 'third');

    xlog $self, "assert the uid is in exactly one resource";
    my $resources = uid_resources($user, $uid);
    $self->assert_num_equals(1, scalar $resources->@*,
        "uid $uid is in resources " . join(' ', $resources->@*));
}
