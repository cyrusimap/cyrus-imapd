#!perl
use Cassandane::Tiny;

# All components sharing one iCalendar UID are stored in a single CalDAV
# resource, and so in a single calendar, whichever calendar a
# CalendarEvent/set create names in calendarIds.

my sub uid_resources ($user, $uid)
{
    my $res = $user->jmap->request([
        ['CalendarEvent/get', {
            ids        => undef,
            properties => ['uid', 'x-href'],
        }, 'R1'],
    ]);

    my %resource;
    for my $event ($res->single_sentence('CalendarEvent/get')
                        ->arguments->{list}->@*) {
        next if $event->{uid} ne $uid;
        $resource{$event->{'x-href'}} = 1;
    }

    return [sort keys %resource];
}

sub assert_uid_other_calendar ($self, $in_calendarA, $in_calendarB)
{
    my $user = $self->default_user;
    my $uid = 'event1uid';

    my $calendarA = $user->calendars->default;
    my $calendarB = $user->calendars->create({ name => 'calendarB' });

    xlog $self, "create event in calendar A";
    $calendarA->create_event({
        uid   => $uid,
        title => 'in calendarA',
        %$in_calendarA,
    });

    xlog $self, "create event with same uid in calendar B";
    $user->jmap->request([
        ['CalendarEvent/set', {
            create => {
                event => {
                    version     => '2.0',
                    uid         => $uid,
                    calendarIds => { $calendarB->id => JSON::true },
                    title       => 'in calendarB',
                    start       => '2026-02-02T02:02:02',
                    timeZone    => 'Etc/UTC',
                    duration    => 'PT1H',
                    %$in_calendarB,
                },
            },
        }, 'R1'],
    ]);

    xlog $self, "assert the uid is in exactly one resource";
    my $resources = uid_resources($user, $uid);
    $self->assert_num_equals(1, scalar $resources->@*,
        "uid $uid is in resources " . join(' ', $resources->@*));
}

sub test_calendarevent_set_uid_other_calendar__standalone_instance ($self)
{
    # The main event is in calendar A, a standalone instance goes to B.
    $self->assert_uid_other_calendar({}, {
        recurrenceId         => '2026-02-02T02:02:02',
        recurrenceIdTimeZone => 'Etc/UTC',
    });
}

sub test_calendarevent_set_uid_other_calendar__main_event ($self)
{
    # A standalone instance is in calendar A, the main event goes to B.
    $self->assert_uid_other_calendar({
        recurrenceId         => '2026-01-01T01:01:01',
        recurrenceIdTimeZone => 'Etc/UTC',
    }, {});
}
