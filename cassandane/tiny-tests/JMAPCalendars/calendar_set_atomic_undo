#!perl
use Cassandane::Tiny;

sub test_calendar_set_atomic_undo
    :NoStartInstances
    ($self)
{
    $self->config_set(debug_jmap_atomic_failstep => 12);
    $self->_start_instances();
    $self->{instance}->create_user('sharee');

    my $jmap = $self->default_user->new_jmaptester;
    $jmap->AddUsing('urn:ietf:params:jmap:conditional');

    my $res = $jmap->request([
        [ 'Calendar/set', { create => {
            x => { name => 'X' },
            y => { name => 'Y', color => 'blue' },
        } } ],
    ]);
    my $created = $res->single_sentence('Calendar/set')->arguments->{created};
    my $idX = $created->{x}{id};
    my $idY = $created->{y}{id};
    $self->assert_not_null($idX);
    $self->assert_not_null($idY);

    # an event in X, with an alert that fires a few minutes from now
    my $now = DateTime->now();
    $now->set_time_zone('Etc/UTC');
    $now->add(DateTime::Duration->new(seconds => 300));
    my $start = $now->clone();
    $start->add(DateTime::Duration->new(seconds => 2));

    $res = $jmap->request([
        [ 'CalendarEvent/set', { create => { e => {
            '@type'     => 'Event',
            version     => '2.0',
            calendarIds => { $idX => JSON::true },
            title       => 'in X',
            start       => $start->strftime('%Y-%m-%dT%H:%M:%S'),
            timeZone    => 'Etc/UTC',
            duration    => 'PT1H',
            alerts      => { alertX => {
                '@type' => 'Alert',
                trigger => {
                    '@type'    => 'OffsetTrigger',
                    relativeTo => 'start',
                    offset     => 'PT0S',
                },
                action => 'display',
            } },
        } } } ],
    ]);
    my $eventId = $res->single_sentence('CalendarEvent/set')
                      ->arguments->{created}{e}{id};
    $self->assert_not_null($eventId);

    my $props = [ 'name', 'color', 'isDefault', 'isSubscribed', 'shareWith' ];
    $res = $jmap->request([
        [ 'Calendar/get', { properties => $props } ],
    ]);
    my $before = $res->single_sentence('Calendar/get')->arguments;

    xlog $self, "a failure at the last write undoes everything before it";
    $res = $jmap->request([
        [ 'Calendar/set', {
            atomic  => JSON::true,
            destroy => [ $idX ],
            onDestroyRemoveEvents => JSON::true,
            create  => { z => { name => 'Z' } },
            update  => { $idY => {
                name      => 'renamed',
                color     => 'red',
                shareWith => { sharee => { mayReadItems => JSON::true } },
            } },
            onSuccessSetIsDefault => $idY,
        } ],
    ]);
    $self->assert_cmp_deeply(
        superhashof({ type => 'serverFail' }),
        $res->single_sentence('error')->arguments,
    );
    $self->assert_syslog_matches($self->{instance},
                                 qr{event=jmap\.calendar\.set\.failed});

    $res = $jmap->request([
        [ 'Calendar/get', { properties => $props } ],
    ]);
    my $after = $res->single_sentence('Calendar/get')->arguments;
    $self->assert_cmp_deeply(
        bag($before->{list}->@*),
        $after->{list},
    );

    xlog $self, "the restored calendar's event keeps its id and its alarm";
    $res = $jmap->request([
        [ 'CalendarEvent/get', {
            ids        => [ $eventId ],
            properties => [ 'calendarIds', 'title' ],
        } ],
    ]);
    $self->assert_cmp_deeply(
        [ superhashof({
            id          => $eventId,
            calendarIds => { $idX => JSON::true },
            title       => 'in X',
        }) ],
        $res->single_sentence('CalendarEvent/get')->arguments->{list},
    );

    $self->{instance}->run_command({ cyrus => 1 },
        'calalarmd', '-t' => $now->epoch() - 60);
    $self->{instance}->getnotify();
    $self->{instance}->run_command({ cyrus => 1 },
        'calalarmd', '-t' => $now->epoch() + 60);
    my @alarms = grep { $_->{event} eq 'CalendarAlarm' }
                 map { decode_json($_->{MESSAGE}) }
                 grep { $_->{CLASS} eq 'EVENT' }
                 $self->{instance}->getnotify()->@*;
    $self->assert_cmp_deeply(
        [ superhashof({ alertId => 'alertX' }) ],
        \@alarms,
    );
}
