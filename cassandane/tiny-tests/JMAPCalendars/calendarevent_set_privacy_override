#!perl
use Cassandane::Tiny;

sub test_calendarevent_set_privacy_override
    ($self)
{
    my $jmap = $self->default_user->jmap;
    my $default_cal_id = $self->default_user->calendars->default->id;

    xlog "Reject overridden privacy in CalendarEvent/set";
    my $res = $jmap->CallMethods([
        ['CalendarEvent/set', {
            create => {
                event1 => {
                    version => '2.0',
                    calendarIds => {
                        $default_cal_id => JSON::true,
                    },
                    uid => 'event1uidlocal',
                    title => 'event1',
                    start => '2020-01-01T09:00:00',
                    timeZone => 'Europe/Vienna',
                    duration => 'PT1H',
                    privacy => 'private',
                    recurrenceRule => {
                        frequency => 'daily',
                        count => 3,
                    },

                    recurrenceOverrides => {
                        '2020-01-02T09:00:00' => {
                            title => 'event1Override',
                            privacy => 'secret',
                        },
                    },
                },
            },
        }, 'R1'],
    ]);
    $self->assert_cmp_deeply({
        type => 'invalidProperties',
        properties => ['recurrenceOverrides/2020-01-02T09:00:00/privacy'],
    }, $res->[0][1]{notCreated}{event1});
}
