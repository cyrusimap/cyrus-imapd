#!perl
use Cassandane::Tiny;

# A subscription change that can't be written must be reported, not hidden
# behind an "updated" for a calendar whose isSubscribed didn't change.
sub test_calendar_set_issubscribed_fail ($self)
{
    my $jmap  = $self->default_user->jmap;
    my $admin = $self->{adminstore}->get_client();

    my $other = $self->{instance}->create_user('other');
    my $cal = $other->calendars->default;
    $admin->setacl('user.other.#calendars.Default', cassandane => 'lr')
        or die "setacl: $@";

    xlog $self, "make cassandane's subscriptions database unwritable";
    $self->{store}->get_client()->subscribe('INBOX')
        or die "subscribe: $@";
    my $subfile = $self->{instance}->get_conf_user_file('cassandane', 'sub');
    $self->assert_not_null($subfile);
    $self->assert(-f $subfile, "$subfile exists");
    my $mode = (stat $subfile)[2] & 07777;
    $self->assert_num_equals(1, chmod(0400, $subfile));

    my $res = eval {
        $jmap->request([
            [ 'Calendar/set', {
                accountId => 'other',
                update    => { $cal->id => { isSubscribed => JSON::true } },
            } ],
        ]);
    };
    my $error = $@;

    # Restore the file before asserting, so the end-of-test checks can run
    $self->assert_num_equals(1, chmod($mode, $subfile));

    $self->assert_str_equals('', "$error");

    my $args = $res->single_sentence('Calendar/set')->arguments;
    $self->assert_null($args->{updated});
    $self->assert_cmp_deeply(
        { $cal->id => superhashof({ type => 'serverFail' }) },
        $args->{notUpdated},
    );
    $self->assert_syslog_matches($self->{instance},
                                 qr/jmap\.calendar\.subscription\.write\.failed/);

    $res = $jmap->request([
        [ 'Calendar/get', {
            accountId  => 'other',
            ids        => [ $cal->id ],
            properties => [ 'isSubscribed' ],
        } ],
    ]);
    $self->assert_cmp_deeply(
        [ superhashof({ isSubscribed => jfalse() }) ],
        $res->single_sentence('Calendar/get')->arguments->{list},
    );
}
