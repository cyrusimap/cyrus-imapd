# build.cfg: glue layer for passing autotools details to MakeMaker
# SPDX-License-Identifier: BSD-3-Clause-CMU
# See COPYING file at the root of the distribution for more details.
use warnings;
use strict;

# This is the set of configure variables that can be expanded below.
#
# If you get an opaque 'failed to generate Makefile' error from
# configure, there's probably something missing.
my $abs_top_builddir = '@abs_top_builddir@';
my $abs_top_srcdir = '@abs_top_srcdir@';
my $top_builddir = '@top_builddir@';
my $top_srcdir = '@top_srcdir@';
my $prefix = '@prefix@';

{
    abs_top_builddir => $abs_top_builddir,
    abs_top_srcdir => $abs_top_srcdir,
    top_builddir => $top_builddir,
    top_srcdir => $top_srcdir,
    prefix => $prefix,

    COM_ERR_CPPFLAGS => "@COM_ERR_CPPFLAGS@",
    GCOV_CFLAGS => "@GCOV_CFLAGS@",
    GCOV_LDFLAGS => "@GCOV_LDFLAGS@",
    GCOV_LIBS => "@GCOV_LIBS@",
    ICU_LIBS => "@ICU_LIBS@",
    LIB_REGEX => "@LIB_REGEX@",
    LIB_SASL => "@LIB_SASL@",
    LIB_UUID => "@LIB_UUID@",
    MYSQL_LIBADD => "@MYSQL_LIBADD@",
    PGSQL_LIBADD => "@PGSQL_LIBADD@",
    SASLFLAGS => "@SASLFLAGS@",
    SQLITE_LIBADD => "@SQLITE_LIBADD@",
    SSL_CFLAGS => "@SSL_CFLAGS@",
    SSL_LIBS => "@SSL_LIBS@",
    ZLIB => "@ZLIB@",
};
# vim: set ft=perl :
