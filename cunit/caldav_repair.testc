/* Unit test for imap/caldav_repair.c
 *
 * Each test builds a user with real calendar mailboxes and index records,
 * runs caldav_repair_uid_conflicts() over them, and then reads the DAV
 * database and the stored resources back.
 */

#if HAVE_CONFIG_H
#include <config.h>
#endif

#include <errno.h>
#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

#include "cunit/unit.h"

#include "imap/annotate.h"
#include "imap/append.h"
#include "imap/caldav_db.h"
#include "imap/caldav_repair.h"
#include "imap/caldav_util.h"
#include "imap/dlist.h"
#include "imap/global.h"
#include "imap/ical_support.h"
#include "imap/imap_err.h"
#include "imap/mailbox.h"
#include "imap/mboxlist.h"
#include "imap/mboxname.h"
#include "imap/quota.h"
#include "imap/user.h"
#include "lib/auth.h"
#include "lib/cyrusdb.h"
#include "lib/libconfig.h"
#include "lib/util.h"
#include "lib/xmalloc.h"
#include "lib/xunlink.h"

#define DBDIR       "test-caldav-repair-dbdir"
#define PARTITION   "default"
#define ACL         "cassandane\tlrswipkxtecdan\t"
#define USERID      "cassandane"

/* Fixed uniqueids, because the tie-break of last resort is the mailbox id and
 * a test that asserts which resource was kept needs to know the order. */
#define CAL_A       "Default"
#define CAL_A_ID    "11111111-1111-1111-1111-111111111111"
#define CAL_B       "Other"
#define CAL_B_ID    "22222222-2222-2222-2222-222222222222"
#define CAL_INBOX   "Inbox"
#define INBOX_ID    "33333333-3333-3333-3333-333333333333"

#define EVENT_UID   "event1uid"

static struct auth_state *auth_state;

/*
 * Fixtures
 */

