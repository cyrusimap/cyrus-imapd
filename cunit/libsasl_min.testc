static void test_canonuser_internal_inplace(void)
{
    sasl_conn_t *conn = NULL;
    const sasl_utils_t *utils = NULL;
    const char expect[] = "foo@realm";
    char inout_user[16] = "foo";
    unsigned actual_len;
    int r;

    r = sasl_server_init(NULL, "nothing");
    CU_ASSERT_EQUAL_FATAL(r, SASL_OK);

    r = sasl_server_new("nothing", NULL, "realm", NULL, NULL, NULL, 0, &conn);
    CU_ASSERT_EQUAL_FATAL(r, SASL_OK);
    utils = ((const sasl_server_conn_t *) conn)->sparams->utils;

    /* must accept same pointer for user and out_user */
    r = _canonuser_internal(utils,
                            inout_user,
                            strlen(inout_user),
                            /* flags */ 0,
                            inout_user,
                            sizeof(inout_user),
                            &actual_len);

    CU_ASSERT_EQUAL(r, SASL_OK);
    CU_ASSERT_EQUAL(actual_len, strlen(expect));
    CU_ASSERT_STRING_EQUAL(inout_user, expect);

    sasl_dispose(&conn);
    sasl_server_done();
}

